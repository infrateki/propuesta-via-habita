# =====================================================================
# VIA-HABITA — Environment variables
# Copy this file to .env.local and fill in real values for development.
# In production (Vercel) these are configured via the dashboard.
# =====================================================================

# ---------- Stripe ----------
# Public (client-side safe) publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret server-side key — never expose
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret from `stripe listen` or the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- WhatsApp ----------
# E.164 number without "+" (e.g., 15514309185)
NEXT_PUBLIC_WHATSAPP_NUMBER=15514309185

# ---------- Scheduling ----------
# Cal.com or Calendly URL for the 30-minute kickoff call
NEXT_PUBLIC_CALENDLY_URL=https://cal.com/sergio-infratek/30min

# ---------- Site ----------
# Public origin used for Stripe success/cancel URLs and emails.
# Use http://localhost:3000 locally; the deployed origin in prod.
NEXT_PUBLIC_SITE_URL=https://viahabita.infratek.ai
